{
  "name": "26-sd-mr-bid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "山东第一医科大学附属消化病医院病案无纸化归档系统采购项目原型演示",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "db:build": "node scripts/build-sqlite.mjs",
    "prebuild": "node scripts/build-sqlite.mjs && cp schema.sql public/schema.sql",
    "build": "vite build",
    "preview": "vite preview",
    "preview:worker": "npm run build && wrangler dev",
    "lint": "eslint . --fix",
    "deploy": "npm run build && node scripts/deploy-allworld.mjs 26-sd-mr-bid",
    "deploy:r2": "node scripts/deploy-allworld.mjs 26-sd-mr-bid",
    "deploy:worker": "node -e \"console.error('禁止 deploy:worker — 共享 allworld 由平台统一维护，本站仅发布 R2 静态与 SQLite'); process.exit(1)\""
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "lucide-vue-next": "^0.511.0",
    "pinia": "^3.0.3",
    "sql.js": "^1.13.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tailwindcss/forms": "^0.5.10",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.19",
    "vue-eslint-parser": "^10.2.0",
    "wrangler": "^4.28.0"
  }
}
